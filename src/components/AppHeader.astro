---
const path = Astro.url.pathname;
const navigation = [
  { name: 'Overview', href: '/', icon: 'fa-house' },
  { name: 'Actors', href: '/actors/', icon: 'fa-user-group' },
  { name: 'Campaigns', href: '/campaigns/', icon: 'fa-bullseye' },
  { name: 'Malware', href: '/malware/', icon: 'fa-bug' },
  { name: 'Tools', href: '/tools/', icon: 'fa-hammer' },
  { name: 'Techniques', href: '/techniques/', icon: 'fa-diagram-project' },
  { name: 'Sources', href: '/sources/', icon: 'fa-book' },
  { name: 'Updates', href: '/updates/', icon: 'fa-clock-rotate-left' },
  { name: 'About', href: '/about/', icon: 'fa-circle-info' }
];
const active = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
const current = navigation.find(item => active(item.href))?.name ?? 'APT Notes';
---
<aside class="sidebar" id="site-nav">
  <header class="sidebar-profile">
    <a class="sidebar-mark" href="https://hecavex.com/en/" aria-label="HECAVEX home"><img src="/brand/hecavex-mark.svg" alt="" width="72" height="72" /></a>
    <a class="site-title" href="https://hecavex.com/en/">HECAVEX</a>
    <p class="site-subtitle">Cyber Threat Intelligence &amp; Digital Investigations</p>
    <details class="language-switcher workspace-switcher">
      <summary aria-label="Switch HECAVEX workspace">
        <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
        <span class="language-label">Workspace</span>
        <strong>APT Notes</strong>
        <i class="fa-solid fa-chevron-down language-chevron" aria-hidden="true"></i>
      </summary>
      <div class="language-menu">
        <a href="https://hecavex.com/en/"><span>Research</span><small>MAIN</small></a>
        <a href="/" aria-current="page"><span>APT Notes</span><small>TI</small></a>
        <a href="https://labs.hecavex.com/"><span>HECAVEX Labs</span><small>TOOLS</small></a>
      </div>
    </details>
    <details class="language-switcher">
      <summary aria-label="Switch language">
        <i class="fa-solid fa-globe" aria-hidden="true"></i>
        <span class="language-label">Language</span>
        <strong>English</strong>
        <i class="fa-solid fa-chevron-down language-chevron" aria-hidden="true"></i>
      </summary>
      <div class="language-menu">
        <a href="/" lang="en" hreflang="en" aria-current="page"><span>English</span><small>EN</small></a>
        <a href="https://hecavex.com/lt/" lang="lt" hreflang="lt"><span>Lietuvių</span><small>LT</small></a>
      </div>
    </details>
  </header>
  <nav aria-label="Primary navigation">
    <ul>
      {navigation.map(item => <li><a href={item.href} aria-current={active(item.href) ? 'page' : undefined}><i class={`fa-solid ${item.icon} fa-fw`} aria-hidden="true"></i><span>{item.name}</span></a></li>)}
    </ul>
    <a class="external" href="https://hecavex.com/en/"><i class="fa-solid fa-arrow-up-right-from-square fa-fw" aria-hidden="true"></i><span>HECAVEX RESEARCH</span></a>
    <a class="external external-secondary" href="https://labs.hecavex.com/"><i class="fa-solid fa-flask fa-fw" aria-hidden="true"></i><span>HECAVEX LABS</span></a>
  </nav>
  <div class="sidebar-bottom">
    <button class="icon-button theme-toggle" type="button" aria-label="Change colour theme" title="Theme: system"><i class="fa-regular fa-moon" aria-hidden="true"></i><span class="theme-label">Theme</span></button>
    <a class="icon-button" href="/feed.xml" aria-label="APT Notes feed"><i class="fa-solid fa-rss" aria-hidden="true"></i><span>RSS</span></a>
  </div>
</aside>

<header class="topbar-wrapper">
  <div class="topbar">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <span><a href="/">Home</a></span>
      {path !== '/' && <span>{current}</span>}
    </nav>
    <button class="topbar-button menu-toggle" type="button" aria-label="Open navigation menu" aria-controls="site-nav" aria-expanded="false"><i class="fa-solid fa-bars fa-fw" aria-hidden="true"></i></button>
    <div class="topbar-title">HECAVEX</div>
    <details class="topbar-language">
      <summary aria-label="Switch language"><i class="fa-solid fa-globe" aria-hidden="true"></i><strong>EN</strong><i class="fa-solid fa-chevron-down language-chevron" aria-hidden="true"></i></summary>
      <div class="language-menu"><a href="/" aria-current="page"><span>English</span><small>EN</small></a><a href="https://hecavex.com/lt/"><span>Lietuvių</span><small>LT</small></a></div>
    </details>
    <button class="topbar-button search-toggle" type="button" aria-label="Search"><i class="fa-solid fa-search fa-fw" aria-hidden="true"></i></button>
    <form class="global-search" action="/search/" role="search">
      <label class="sr-only" for="global-q">Search APT Notes</label>
      <i class="fa-solid fa-search fa-fw" aria-hidden="true"></i>
      <input id="global-q" name="q" type="search" placeholder="Search APT Notes" autocomplete="off" />
    </form>
    <button class="search-cancel" type="button">Cancel</button>
  </div>
</header>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const button = document.querySelector('.theme-toggle');
    const icon = button?.querySelector('i');
    const modes = ['system', 'dark', 'light'];
    let mode = 'system';
    try { mode = localStorage.getItem('apt-notes-theme') || 'system'; } catch {}
    const apply = (next) => {
      mode = modes.includes(next) ? next : 'system';
      if (mode === 'system') root.removeAttribute('data-theme'); else root.dataset.theme = mode;
      if (button) button.title = `Theme: ${mode}`;
      if (icon) icon.className = mode === 'light' ? 'fa-regular fa-sun' : mode === 'dark' ? 'fa-regular fa-moon' : 'fa-solid fa-display';
      try { localStorage.setItem('apt-notes-theme', mode); } catch {}
    };
    apply(mode);
    button?.addEventListener('click', () => apply(modes[(modes.indexOf(mode) + 1) % modes.length]));
    const menu = document.querySelector('.menu-toggle');
    const sidebar = document.querySelector('.sidebar');
    menu?.addEventListener('click', () => {
      const open = menu.getAttribute('aria-expanded') === 'true';
      menu.setAttribute('aria-expanded', String(!open));
      sidebar?.classList.toggle('is-open', !open);
    });
    const searchToggle = document.querySelector('.search-toggle');
    const searchCancel = document.querySelector('.search-cancel');
    const topbar = document.querySelector('.topbar');
    searchToggle?.addEventListener('click', () => { topbar?.classList.add('search-open'); document.querySelector('#global-q')?.focus(); });
    searchCancel?.addEventListener('click', () => topbar?.classList.remove('search-open'));
  })();
</script>
