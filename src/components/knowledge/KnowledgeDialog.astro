<dialog class="knowledge-dialog" data-knowledge-dialog aria-labelledby="knowledge-dialog-heading">
  <div class="knowledge-dialog-frame">
    <div class="knowledge-dialog-bar">
      <span>APT Notes / contextual record</span>
      <button type="button" data-knowledge-dialog-close aria-label="Close record">Close <span aria-hidden="true">×</span></button>
    </div>
    <div class="knowledge-dialog-content" data-knowledge-dialog-content></div>
  </div>
</dialog>

<script>
  const secondaryPath = /^\/(campaigns|malware|tools|techniques|sources)\/[a-z0-9]+(?:-[a-z0-9]+)*\/$/;

  const initialiseKnowledgeDialog = () => {
    const dialog = document.querySelector<HTMLDialogElement>('[data-knowledge-dialog]');
    const content = dialog?.querySelector<HTMLElement>('[data-knowledge-dialog-content]');
    const closeButton = dialog?.querySelector<HTMLButtonElement>('[data-knowledge-dialog-close]');
    if (!dialog || !content || !closeButton || dialog.dataset.ready === 'true') return;
    dialog.dataset.ready = 'true';

    const cache = new Map<string, { fragment: HTMLElement; title: string }>();
    let request: AbortController | undefined;
    let firstTrigger: HTMLElement | null = null;
    let firstTriggerHref = '';
    let backgroundTitle = document.title;
    let backgroundScroll = window.scrollY;

    const isEligible = (link: HTMLAnchorElement, event: MouseEvent) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return false;
      if (link.target || link.download || link.dataset.knowledgeBypass !== undefined) return false;
      const url = new URL(link.href, window.location.href);
      return url.origin === window.location.origin && secondaryPath.test(url.pathname) && typeof dialog.showModal === 'function';
    };

    const setLoading = () => {
      content.replaceChildren();
      dialog.setAttribute('aria-labelledby', 'knowledge-dialog-heading');
      const state = document.createElement('div');
      state.className = 'knowledge-dialog-state';
      state.setAttribute('role', 'status');
      state.setAttribute('aria-live', 'polite');
      const heading = document.createElement('h2');
      heading.id = 'knowledge-dialog-heading';
      heading.tabIndex = -1;
      heading.textContent = 'Loading record…';
      const message = document.createElement('p');
      message.textContent = 'Retrieving the published fallback record.';
      state.append(heading, message);
      content.append(state);
    };

    const setError = (url: URL) => {
      content.replaceChildren();
      dialog.setAttribute('aria-labelledby', 'knowledge-dialog-heading');
      const state = document.createElement('div');
      state.className = 'knowledge-dialog-state';
      state.setAttribute('role', 'alert');
      const heading = document.createElement('h2');
      heading.id = 'knowledge-dialog-heading';
      heading.tabIndex = -1;
      heading.textContent = 'Record could not be loaded';
      const message = document.createElement('p');
      message.textContent = 'The in-context view failed. The addressable record is still available.';
      const fallback = document.createElement('a');
      fallback.className = 'button';
      fallback.href = url.href;
      fallback.dataset.knowledgeBypass = '';
      fallback.textContent = 'Open full record';
      state.append(heading, message, fallback);
      content.append(state);
      heading.focus({ preventScroll: true });
    };

    const fetchRecord = async (url: URL) => {
      const existing = cache.get(url.href);
      if (existing) return { fragment: existing.fragment.cloneNode(true) as HTMLElement, title: existing.title };
      request?.abort();
      request = new AbortController();
      const response = await fetch(url.href, { signal: request.signal, headers: { Accept: 'text/html' } });
      if (!response.ok) throw new Error(`Record returned ${response.status}`);
      const parsed = new DOMParser().parseFromString(await response.text(), 'text/html');
      const fragment = parsed.querySelector<HTMLElement>('[data-knowledge-record-fragment]');
      if (!fragment) throw new Error('Record fragment missing');
      fragment.querySelectorAll('script, style, iframe, object, embed').forEach((node) => node.remove());
      fragment.querySelectorAll<HTMLElement>('*').forEach((node) => {
        for (const attribute of [...node.attributes]) if (attribute.name.toLowerCase().startsWith('on')) node.removeAttribute(attribute.name);
      });
      cache.set(url.href, { fragment: fragment.cloneNode(true) as HTMLElement, title: parsed.title });
      return { fragment, title: parsed.title };
    };

    const showRecord = async (url: URL, focus = true) => {
      setLoading();
      if (!dialog.open) dialog.showModal();
      try {
        const record = await fetchRecord(url);
        const heading = record.fragment.querySelector<HTMLElement>('h1, h2');
        if (heading) {
          if (!heading.id) heading.id = 'knowledge-dialog-heading';
          heading.tabIndex = -1;
          dialog.setAttribute('aria-labelledby', heading.id);
        }
        content.replaceChildren(record.fragment);
        document.title = record.title || backgroundTitle;
        if (focus) (heading ?? closeButton).focus({ preventScroll: true });
      } catch (error) {
        if ((error as Error).name !== 'AbortError') setError(url);
      }
    };

    const pushRecord = (url: URL, trigger: HTMLElement) => {
      const current = history.state?.aptKnowledgeDialog ? history.state : undefined;
      if (!current) {
        firstTrigger = trigger;
        firstTriggerHref = trigger instanceof HTMLAnchorElement ? trigger.href : '';
        backgroundTitle = document.title;
        backgroundScroll = window.scrollY;
      }
      const depth = (current?.depth ?? 0) + 1;
      history.pushState({
        aptKnowledgeDialog: true,
        recordUrl: url.href,
        depth,
        backgroundTitle: current?.backgroundTitle ?? backgroundTitle,
        backgroundScroll: current?.backgroundScroll ?? backgroundScroll
      }, '', url.href);
      void showRecord(url);
    };

    document.addEventListener('click', (event) => {
      const target = event.target as Element | null;
      const copy = target?.closest<HTMLButtonElement>('[data-copy-record-url]');
      if (copy) {
        const value = copy.dataset.copyRecordUrl || window.location.href;
        void navigator.clipboard?.writeText(value).then(() => {
          const previous = copy.textContent;
          copy.textContent = 'Copied';
          window.setTimeout(() => { copy.textContent = previous; }, 1600);
        });
        return;
      }
      const link = target?.closest<HTMLAnchorElement>('a[href]');
      if (!link || !isEligible(link, event)) return;
      event.preventDefault();
      pushRecord(new URL(link.href), link);
    });

    const closeToBackground = () => {
      const depth = Number(history.state?.depth ?? 0);
      if (history.state?.aptKnowledgeDialog && depth > 0) history.go(-depth);
      else dialog.close();
    };

    closeButton.addEventListener('click', closeToBackground);
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeToBackground();
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) closeToBackground();
    });

    window.addEventListener('popstate', (event) => {
      request?.abort();
      if (event.state?.aptKnowledgeDialog && event.state.recordUrl) {
        backgroundTitle = event.state.backgroundTitle ?? backgroundTitle;
        backgroundScroll = event.state.backgroundScroll ?? backgroundScroll;
        void showRecord(new URL(event.state.recordUrl), true);
        return;
      }
      if (dialog.open) dialog.close();
      document.title = backgroundTitle;
      window.scrollTo({ top: backgroundScroll, behavior: 'auto' });
      const triggerToRestore = firstTrigger;
      const triggerHrefToRestore = firstTriggerHref;
      firstTrigger = null;
      firstTriggerHref = '';
      window.requestAnimationFrame(() => {
        const replacement = triggerToRestore?.isConnected
          ? triggerToRestore
          : [...document.querySelectorAll<HTMLAnchorElement>('a[data-knowledge-link]')]
            .find((link) => link.href === triggerHrefToRestore);
        replacement?.focus({ preventScroll: true });
      });
    });
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initialiseKnowledgeDialog, { once: true });
  else initialiseKnowledgeDialog();
</script>
