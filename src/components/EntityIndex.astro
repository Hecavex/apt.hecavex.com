---
import { label } from '../utils/content';
interface Entry { data: { name?: string; title?: string; slug: string; summary?: string; draft: boolean; confidence?: string; last_reviewed?: Date; publisher?: string; mitre_id?: string } }
interface Props { title: string; description: string; type: string; base: string; entries: Entry[]; }
const { title, description, type, base, entries } = Astro.props;
---
<section class="shell">
  <header class="page-head"><div><p class="eyebrow">{type} catalogue</p><h1>{title}</h1><p class="lead">{description}</p></div><span class="meta">{entries.length} public {entries.length === 1 ? 'record' : 'records'}</span></header>
  {entries.length ? <div class="database-list" data-pagefind-body>
    {entries.map((entry) => <article class="db-row" data-pagefind-meta={`type:${type}`}>
      <div class="db-cell"><h2><a href={`${base}${entry.data.slug}/`}>{entry.data.name ?? entry.data.title}</a></h2><p>{entry.data.summary}</p></div>
      <div class="db-cell"><small>Type</small>{type}</div>
      <div class="db-cell"><small>Confidence</small>{entry.data.confidence ? <span class={`badge ${entry.data.confidence}`}>{label(entry.data.confidence)}</span> : '—'}</div>
      <div class="db-cell"><small>Identifier</small><span class="mono">{entry.data.mitre_id ?? entry.data.slug}</span></div>
      <div class="db-cell"><small>Publisher</small>{entry.data.publisher ?? 'APT Notes'}</div>
    </article>)}
  </div> : <div class="empty"><h2>No public profiles yet</h2><p>Draft and placeholder records are excluded. New sourced records will appear after editorial review.</p></div>}
</section>
