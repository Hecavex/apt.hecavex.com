---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { publicEntries, label, unique, formatDate, reviewStatus } from '../../utils/content';
const actors:any[] = await publicEntries('actors');
const origins=unique(actors.flatMap(a=>a.data.suspected_origins)).sort(); const regions=unique(actors.flatMap(a=>a.data.targeting.regions)).sort(); const sectors=unique(actors.flatMap(a=>a.data.targeting.sectors)).sort(); const malware=unique(actors.flatMap(a=>a.data.malware)).sort();
---
<BaseLayout title="Threat Actors" description="Search and filter source-backed threat actor profiles.">
<section class="shell"><header class="page-head"><div><p class="eyebrow">Entity catalogue</p><h1>Threat actors</h1><p class="lead">Search source-backed profiles and filter by classification, origin, motivation, status, targeting and confidence.</p></div><span class="meta" id="result-count">{actors.length} profiles</span></header>
<p class="scope-note"><strong>Baltic evidence:</strong> country-level records with explicit evidence classes, sources and local relevance are available in the <a href="/baltic-relevance/">Baltic relevance view</a>.</p>
<form class="controls" id="actor-controls" aria-label="Actor filters">
  <div class="filter-essentials">
    <label>Search<input type="search" name="q" placeholder="Name, alias, sector…" /></label>
    <label>Sort<select name="sort"><option value="name">Actor name</option><option value="reviewed">Recently reviewed</option><option value="observed">Recently observed</option><option value="active">Active since</option><option value="confidence">Confidence</option></select></label>
  </div>
  <details class="advanced-filters" id="advanced-actor-filters">
    <summary>
      <span>More filters</span>
      <span class="advanced-filter-state" aria-live="polite"><strong data-active-filter-count>0</strong> active</span>
    </summary>
    <div class="advanced-filter-grid">
      <label>Origin<select name="origin"><option value="">All origins</option>{origins.map(v=><option value={v.toLowerCase()}>{v}</option>)}</select></label>
      <label>Target region<select name="region"><option value="">All regions</option>{regions.map(v=><option value={v.toLowerCase()}>{v}</option>)}</select></label>
      <label>Target sector<select name="sector"><option value="">All sectors</option>{sectors.map(v=><option value={v.toLowerCase()}>{v}</option>)}</select></label>
      <label>Actor type<select name="type"><option value="">All types</option>{unique(actors.flatMap(a=>a.data.actor_types)).sort().map(v=><option value={v}>{label(v)}</option>)}</select></label>
      <label>Motivation<select name="motivation"><option value="">All motivations</option>{unique(actors.flatMap(a=>a.data.motivations)).sort().map(v=><option value={v}>{label(v)}</option>)}</select></label>
      <label>Status<select name="status"><option value="">All statuses</option>{unique(actors.map(a=>a.data.status)).sort().map(v=><option value={v}>{label(v)}</option>)}</select></label>
      <label>Confidence<select name="confidence"><option value="">All confidence</option>{unique(actors.map(a=>a.data.confidence)).map(v=><option value={v}>{label(v)}</option>)}</select></label>
      <label>Review state<select name="review"><option value="">All review states</option><option value="current">Current</option><option value="due">Review due</option><option value="stale">Stale</option></select></label>
      <label>Associated malware<select name="malware"><option value="">All malware</option>{malware.map(v=><option value={v}>{label(v)}</option>)}</select></label>
      <label>Active period<input name="period" inputmode="numeric" placeholder="e.g. 2010" /></label>
    </div>
  </details>
  <button class="filter-reset" type="reset">Reset all filters</button>
</form>
<div class="database-list" id="actor-list" data-pagefind-body>{actors.map(a=>{const freshness=reviewStatus(a.data.last_reviewed);return <article class="db-row actor-row" data-name={a.data.name.toLowerCase()} data-search={[a.data.id,a.data.external_identifiers.mitre_attack,a.data.name,...a.data.aliases.map((x:any)=>x.name),a.data.summary,...a.data.targeting.regions,...a.data.targeting.sectors].join(' ').toLowerCase()} data-origin={a.data.suspected_origins.join('|').toLowerCase()} data-region={a.data.targeting.regions.join('|').toLowerCase()} data-sector={a.data.targeting.sectors.join('|').toLowerCase()} data-type={a.data.actor_types.join('|')} data-motivation={a.data.motivations.join('|')} data-status={a.data.status} data-confidence={a.data.confidence} data-review={freshness.key} data-malware={a.data.malware.join('|')} data-active={a.data.active_since} data-observed={a.data.last_observed} data-reviewed={a.data.last_reviewed.toISOString()} data-pagefind-meta="type:Actor"><div class="db-cell"><h2><a href={`/actors/${a.data.slug}/`}>{a.data.name}</a></h2><p>{a.data.aliases.slice(0,3).map((x:any)=>x.name).join(' · ') || 'No public aliases recorded'}</p></div><div class="db-cell"><small>Classification</small>{a.data.actor_types.map((v:string)=><span class="badge">{label(v)}</span>)}</div><div class="db-cell"><small>Origin</small>{a.data.suspected_origins.join(', ')||'Unknown'}</div><div class="db-cell"><small>Status</small><span class={`badge ${a.data.status}`}>{label(a.data.status)}</span></div><div class="db-cell"><small>Review</small><span class={`badge ${freshness.key}`}>{freshness.label}</span><br/>{formatDate(a.data.last_reviewed)}</div></article>})}</div><div class="empty" id="actor-empty" hidden><h2>No matching actors</h2><p>Remove a filter or broaden the search. Draft profiles are never included.</p></div></section>
<script>
const form=document.querySelector<HTMLFormElement>('#actor-controls')!; const rows=[...document.querySelectorAll<HTMLElement>('.actor-row')]; const count=document.querySelector('#result-count')!; const empty=document.querySelector<HTMLElement>('#actor-empty')!; const advanced=document.querySelector<HTMLDetailsElement>('#advanced-actor-filters')!; const activeCount=document.querySelector<HTMLElement>('[data-active-filter-count]')!;
const advancedNames=['origin','region','sector','type','motivation','status','confidence','review','malware','period'];
const confidenceRank:Record<string,number>={high:3,moderate:2,low:1}; const apply=()=>{const data=new FormData(form); const p=new URLSearchParams(); for(const [k,v] of data)if(String(v).trim()&&!(k==='sort'&&v==='name'))p.set(k,String(v).trim()); history.replaceState(null,'',`${location.pathname}${p.size?'?'+p:''}`); const q=String(data.get('q')||'').toLowerCase(); let shown=rows.filter(r=>(!q||r.dataset.search!.includes(q))&&['origin','region','sector','type','motivation','status','confidence','review','malware'].every(k=>{const v=String(data.get(k)||'').toLowerCase();return !v||r.dataset[k]!.split('|').includes(v)})&&(!data.get('period')||Number.parseInt(r.dataset.active||'9999',10)<=Number(data.get('period')))); const sort=String(data.get('sort')||'name'); shown.sort((a,b)=>sort==='reviewed'?b.dataset.reviewed!.localeCompare(a.dataset.reviewed!):sort==='observed'?b.dataset.observed!.localeCompare(a.dataset.observed!):sort==='active'?Number.parseInt(a.dataset.active||'9999',10)-Number.parseInt(b.dataset.active||'9999',10):sort==='confidence'?((confidenceRank[b.dataset.confidence!]??0)-(confidenceRank[a.dataset.confidence!]??0)):a.dataset.name!.localeCompare(b.dataset.name!)); rows.forEach(r=>r.hidden=true); const list=document.querySelector('#actor-list')!; shown.forEach(r=>{r.hidden=false;list.append(r)}); const advancedActive=advancedNames.filter(name=>String(data.get(name)||'').trim()).length; activeCount.textContent=String(advancedActive); advanced.classList.toggle('has-active-filters',advancedActive>0); count.textContent=`${shown.length} ${shown.length===1?'profile':'profiles'}`;empty.hidden=shown.length!==0};
const initial=new URLSearchParams(location.search); for(const [k,v] of initial){const field=form.elements.namedItem(k) as HTMLInputElement|null;if(field)field.value=v} if(advancedNames.some(name=>initial.has(name)))advanced.open=true; form.addEventListener('input',apply);form.addEventListener('change',apply);form.addEventListener('reset',()=>requestAnimationFrame(()=>{advanced.open=false;apply()}));apply();
</script></BaseLayout>
