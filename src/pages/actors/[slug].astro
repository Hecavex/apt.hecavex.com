---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProfileToc from '../../components/ProfileToc.astro';
import KnowledgeLink from '../../components/knowledge/KnowledgeLink.astro';
import { publicEntries, byId, label, formatDate, reviewStatus } from '../../utils/content';

export async function getStaticPaths() {
  return (await getCollection('actors', ({ data }) => !data.draft)).map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const [sources, campaigns, malware, tools, techniques, updates] = await Promise.all(
  ['sources', 'campaigns', 'malware', 'tools', 'techniques', 'updates'].map((name) => publicEntries(name as any))
);
const maps = {
  sources: byId(sources as any),
  campaigns: byId(campaigns as any),
  malware: byId(malware as any),
  tools: byId(tools as any),
  techniques: byId(techniques as any),
  updates: byId(updates as any)
} as any;
const d = entry.data;
const freshness = reviewStatus(d.last_reviewed);

const tocCandidates = [
  ...headings.filter((heading: any) => heading.depth === 2).map((heading: any) => ({ slug: heading.slug, text: heading.text })),
  ...(d.aliases.length > 0 ? [{ slug: 'naming-and-aliases', text: 'Naming and aliases' }] : []),
  ...(d.operational_timeline.length > 0 ? [{ slug: 'operational-timeline', text: 'Operational timeline' }] : []),
  ...(d.baltic_relevance.length > 0 ? [{ slug: 'baltic-relevance', text: 'Baltic relevance' }] : []),
  ...(d.campaigns.length > 0 ? [{ slug: 'campaigns', text: 'Campaigns' }] : []),
  ...(d.malware.length > 0 || d.tools.length > 0 ? [{ slug: 'capabilities', text: 'Malware and tooling' }] : []),
  ...(d.attribution.length > 0 ? [{ slug: 'attribution-statements', text: 'Attribution statements' }] : []),
  ...(d.techniques.length > 0 ? [{ slug: 'techniques', text: 'MITRE ATT&CK techniques' }] : []),
  ...(d.vulnerabilities.length > 0 ? [{ slug: 'vulnerabilities', text: 'Vulnerabilities' }] : []),
  ...(d.related_research.length > 0 ? [{ slug: 'related-research', text: 'Related research' }] : []),
  { slug: 'sources', text: 'References' },
  ...(d.updates.length > 0 ? [{ slug: 'change-history', text: 'Change history' }] : [])
];
const tocItems = [...new Map(tocCandidates.map((item) => [item.slug, item])).values()];
---

<BaseLayout title={`${d.name} | Actor Profile`} description={d.summary} type="ProfilePage" image={`/og/generated/actor-${d.slug}.png`} imageAlt={`${d.name} threat actor profile by APT Notes`}>
  <article id="profile-start" class="shell profile-shell" data-pagefind-body data-pagefind-meta="type:Actor">
    <header class="profile-head">
      <p class="eyebrow">Actor profile · <span class="mono">{d.external_identifiers.mitre_attack || d.id}</span></p>
      <h1>{d.name}</h1>
      <p class="lead">{d.summary}</p>
      <p class="alias-line">Also tracked as: {d.aliases.slice(0, 6).map((alias: any) => alias.name).join(' · ') || 'No public aliases recorded'}</p>
    </header>

    <section class="assessment-strip" aria-labelledby="current-assessment-title">
      <div>
        <p class="eyebrow">Current assessment</p>
        <h2 id="current-assessment-title">Active threat through {d.last_observed}</h2>
        <p>{d.current_assessment}</p>
      </div>
      <dl>
        <div><dt>Attributed operator</dt><dd>{d.parent_entities[0]?.name ?? 'Not recorded'}</dd></div>
        <div><dt>Primary mission</dt><dd>{d.mission}</dd></div>
      </dl>
    </section>

    <dl class="fact-grid">
      {[
        ['Actor type', d.actor_types.map(label).join(', ')],
        ['Status', label(d.status)],
        ['Suspected origin', d.suspected_origins.join(', ') || 'Unknown'],
        ['Motivation', d.motivations.map(label).join(', ')],
        ['Active since', d.active_since],
        ['Last observed', d.last_observed || 'Not stated'],
        ['Confidence', label(d.confidence)],
        ['Last reviewed', formatDate(d.last_reviewed)]
      ].map(([term, value]) => <div class="fact"><dt>{term}</dt><dd>{value}</dd></div>)}
    </dl>

    <div class="profile-release"><span class={`badge ${freshness.key}`}>{freshness.label}</span><span>Review age: {Math.max(0, freshness.ageDays)} days</span><a href={`/api/actors/${d.slug}.json`} download>Download public JSON ↓</a>{['apt28', 'apt44'].includes(d.slug) && <a href={`https://labs.hecavex.com/attack-map/?actor=${d.slug}`}>Interactive ATT&amp;CK evidence map ↗</a>}<a href="/methodology/">Review policy →</a></div>

    <dl class="fact-grid actor-record-state" aria-label="Record state">
      <div class="fact"><dt>Record version</dt><dd class="mono">{d.version}</dd></div>
      <div class="fact"><dt>Created</dt><dd>{formatDate(d.created_at)}</dd></div>
      <div class="fact"><dt>Modified</dt><dd>{formatDate(d.modified_at)}</dd></div>
      <div class="fact"><dt>Review state</dt><dd><span class={`badge ${freshness.key}`}>{freshness.label}</span></dd></div>
      <div class="fact"><dt>Lifecycle</dt><dd>{d.revoked ? 'Revoked' : d.deprecated ? 'Deprecated' : 'Current public record'}</dd></div>
      <div class="fact"><dt>Revision record</dt><dd><a href={`/changes/?entity=actor#${d.updates.at(-1) ?? ''}`}>View changes →</a></dd></div>
    </dl>

    <div class="profile-grid">
      <ProfileToc items={tocItems} />

      <div class="prose profile-body">
        <Content />

        {d.aliases.length > 0 && (
          <section id="naming-and-aliases">
            <h2>Naming and aliases</h2>
            <p class="callout">{d.parent_entities[0]?.name ?? 'The attributed operator'} is an attributed entity, not another vendor alias. Tracking clusters may overlap without being exact one-to-one equivalents.</p>
            <div class="identity-chain" aria-label={`${d.name} attribution hierarchy`}>
              <span>{d.parent_entities[0]?.name ?? 'Attributed operator not recorded'}</span><i aria-hidden="true">→</i><strong>{d.name} analytic record</strong>
            </div>
            <div class="table-wrap profile-table" role="region" aria-label="Actor aliases" tabindex="0">
              <table>
                <colgroup><col class="alias-name" /><col class="alias-source" /><col class="alias-relationship" /><col class="alias-confidence" /><col class="alias-notes" /></colgroup>
                <thead><tr><th>Alias</th><th>Publisher</th><th>Relationship</th><th>Confidence</th><th>Scope and notes</th></tr></thead>
                <tbody>
                  {d.aliases.map((alias: any) => (
                    <tr>
                      <td>{alias.name}</td>
                      <td>{alias.source}</td>
                      <td>{label(alias.relationship)}</td>
                      <td><span class={`badge ${alias.confidence}`}>{label(alias.confidence)}</span></td>
                      <td>{alias.scope}{alias.notes ? ` ${alias.notes}` : ''}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {d.subclusters.length > 0 && <div class="subcluster-note"><span class="eyebrow">Related sub-cluster</span>{d.subclusters.map((cluster: any) => <p><strong>{cluster.name}</strong> · {cluster.source} · {cluster.notes}</p>)}</div>}
          </section>
        )}

        {d.operational_timeline.length > 0 && (
          <section id="operational-timeline">
            <h2>Operational evolution</h2>
            <ol class="timeline evidence-timeline">
              {d.operational_timeline.map((event: any) => <li><time>{event.date}</time><h3>{event.title}</h3><p>{event.summary}</p><p class="evidence-line"><span class={`badge ${event.confidence}`}>{label(event.confidence)}</span>{event.sources.map((id: string) => { const source = maps.sources.get(id); return source ? <KnowledgeLink collection="sources" slug={source.data.slug}>{source.data.publisher}</KnowledgeLink> : <span>{id}</span>; })}</p></li>)}
            </ol>
          </section>
        )}

        {d.baltic_relevance.length > 0 && (
          <section id="baltic-relevance">
            <h2>Baltic relevance</h2>
            <p>Each row is a source-specific evidence statement. Reported targeting, reported compromise, actor claims and reporting connections are not interchangeable.</p>
            <div class="table-wrap profile-table" role="region" aria-label={`${d.name} Baltic relevance evidence`} tabindex="0">
              <table>
                <thead><tr><th>Country and class</th><th>Evidence</th><th>Local significance</th><th>Reference</th></tr></thead>
                <tbody>{d.baltic_relevance.map((relevance: any) => <tr>
                  <td><strong>{relevance.country}</strong><small>{label(relevance.evidence_type)} / {label(relevance.confidence)} confidence / {relevance.first_observed}{relevance.last_observed !== relevance.first_observed ? ` - ${relevance.last_observed}` : ''} / reviewed {relevance.reviewed_at}</small></td>
                  <td>{relevance.summary}<small>{[...relevance.sectors, ...relevance.technologies].join(' / ') || 'No sector or technology asserted'}</small></td>
                  <td>{relevance.why_it_matters}</td>
                  <td>{relevance.sources.map((id: string) => { const source = maps.sources.get(id); return source ? <KnowledgeLink collection="sources" slug={source.data.slug}>{source.data.publisher}</KnowledgeLink> : <span>{id}</span>; })}</td>
                </tr>)}</tbody>
              </table>
            </div>
          </section>
        )}

        {d.campaigns.length > 0 && (
          <section id="campaigns">
            <h2>Campaigns and operational clusters</h2>
            <p>Campaign confidence is evaluated separately from the actor-level attribution.</p>
            <div class="entity-card-grid">
              {d.campaigns.map((id: string) => { const campaign = maps.campaigns.get(id); return campaign ? <KnowledgeLink class="entity-card" collection="campaigns" slug={campaign.data.slug}><span class="entity-card-meta">{campaign.data.start_date}{campaign.data.end_date ? `–${campaign.data.end_date}` : ''} · {label(campaign.data.confidence)} confidence</span><h3>{campaign.data.name}</h3><p>{campaign.data.summary}</p><strong>Inspect campaign →</strong></KnowledgeLink> : null; })}
            </div>
          </section>
        )}

        {(d.malware.length > 0 || d.tools.length > 0) && (
          <section id="capabilities">
            <h2>Malware and tooling</h2>
            <p>The inventory prioritises publicly documented capabilities relevant to current operations. It is not intended to be a complete historical malware catalogue.</p>
            <div class="capability-list">
              {d.malware.map((id: string) => { const item = maps.malware.get(id); return item ? <KnowledgeLink collection="malware" slug={item.data.slug}><span><strong>{item.data.name}</strong><small>{item.data.family_type} · {item.data.platforms.join(', ')}</small></span><i aria-hidden="true">→</i></KnowledgeLink> : null; })}
              {d.tools.map((id: string) => { const item = maps.tools.get(id); return item ? <KnowledgeLink collection="tools" slug={item.data.slug}><span><strong>{item.data.name}</strong><small>{label(item.data.tool_type)} tool · {item.data.platforms.join(', ')}</small></span><i aria-hidden="true">→</i></KnowledgeLink> : null; })}
            </div>
          </section>
        )}

        {d.attribution.length > 0 && (
          <section id="attribution-statements">
            <h2>Source-specific attribution statements</h2>
            {d.attribution.map((attribution: any) => (
              <div class="panel attribution-panel">
                <span class={`badge ${attribution.confidence}`}>{label(attribution.status)}</span>
                <h3>{attribution.attributed_entity}</h3>
                <p>{attribution.claim}</p>
                <p class="meta">Reference: {maps.sources.get(attribution.source) ? <KnowledgeLink collection="sources" slug={maps.sources.get(attribution.source).data.slug}>{maps.sources.get(attribution.source).data.name}</KnowledgeLink> : attribution.source} · {formatDate(attribution.published_at)} · {label(attribution.confidence)} confidence</p>
                <p>{attribution.notes}</p>
              </div>
            ))}
          </section>
        )}

        {d.techniques.length > 0 && (
          <section id="techniques">
            <h2>High-confidence ATT&amp;CK evidence</h2>
            <p>This is a curated evidence set, not a dump of every technique ever associated with {d.name}.</p>
            {['apt28', 'apt44'].includes(d.slug) && <p><a class="button" href={`https://labs.hecavex.com/attack-map/?actor=${d.slug}`}>Explore the interactive evidence matrix ↗</a></p>}
            <div class="technique-grid">
              {d.techniques.map((id: string) => { const technique = maps.techniques.get(id); const evidence = d.technique_evidence.find((item: any) => item.technique === id); return technique ? <KnowledgeLink collection="techniques" slug={technique.data.slug}><span class="mono">{technique.data.mitre_id}</span><strong>{technique.data.name}</strong><small>{technique.data.tactic}{evidence ? ` · ${label(evidence.confidence)} confidence` : ''}</small></KnowledgeLink> : null; })}
            </div>
          </section>
        )}

        {d.vulnerabilities.length > 0 && (
          <section id="vulnerabilities">
            <h2>Observed vulnerability use</h2>
            <p>Each entry records the vulnerability's operational role and source-specific confidence.</p>
            <div class="table-wrap vulnerability-table" role="region" aria-label={`Observed ${d.name} vulnerability use`} tabindex="0">
              <table>
                <thead><tr><th>CVE and product</th><th>Operational role</th><th>First observed</th><th>Confidence</th></tr></thead>
                <tbody>{d.vulnerabilities.map((vulnerability: any) => { const campaign = vulnerability.campaign ? maps.campaigns.get(vulnerability.campaign) : undefined; const source = maps.sources.get(vulnerability.source); return <tr><td><a class="mono" href={`https://www.cve.org/CVERecord?id=${vulnerability.cve}`}>{vulnerability.cve}</a><small>{vulnerability.product}</small></td><td>{vulnerability.role}{campaign && <small><KnowledgeLink collection="campaigns" slug={campaign.data.slug}>{campaign.data.name}</KnowledgeLink></small>}</td><td>{vulnerability.first_observed || 'Not stated'}</td><td><span class={`badge ${vulnerability.confidence}`}>{label(vulnerability.confidence)}</span><small>{source ? <KnowledgeLink collection="sources" slug={source.data.slug}>Evidence</KnowledgeLink> : vulnerability.source}</small></td></tr>; })}</tbody>
              </table>
            </div>
          </section>
        )}

        {d.related_research.length > 0 && <section id="related-research"><h2>Related Hecavex research</h2><ul>{d.related_research.map((research: any) => <li><a href={research.url}>{research.title} ↗</a></li>)}</ul></section>}

        <section id="sources">
          <h2>References</h2>
          <ol class="source-list">{d.sources.map((id: string) => { const source = maps.sources.get(id); return <li>{source ? <><a href={source.data.url}>{source.data.title}</a><span>{source.data.publisher} · {formatDate(source.data.published_at)} · <KnowledgeLink collection="sources" slug={source.data.slug}>Reference record</KnowledgeLink></span></> : <span>{id} · reference record pending</span>}</li>; })}</ol>
        </section>

        {d.updates.length > 0 && (
          <section id="change-history">
            <h2>Change history</h2>
            <ol class="timeline">{d.updates.map((id: string) => { const update = maps.updates.get(id); return update ? <li><time>{formatDate(update.data.date)}</time><h3>{update.data.title}</h3><p>{update.data.summary}</p></li> : null; })}</ol>
          </section>
        )}
      </div>
    </div>
  </article>
</BaseLayout>
