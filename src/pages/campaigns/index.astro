---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogueMoved from '../../components/knowledge/CatalogueMoved.astro';
import { publicEntries } from '../../utils/content';
const entries = await publicEntries('campaigns');
---
<BaseLayout title="Campaigns moved to Knowledge" description="Campaign records now share one Knowledge explorer." noindex={true}>
  <CatalogueMoved name="Campaigns" href="/knowledge/?view=campaigns" count={entries.length} description="Campaign records now open in context beside software, techniques and references." />
</BaseLayout>
