---
import{getCollection}from'astro:content';import BaseLayout from'../../layouts/BaseLayout.astro';import EntityProfile from'../../components/EntityProfile.astro';export async function getStaticPaths(){return(await getCollection('campaigns',({data})=>!data.draft)).map(entry=>({params:{slug:entry.data.slug},props:{entry}}))}const{entry}=Astro.props;
---
<BaseLayout title={`${entry.data.name} | Campaign`} description={entry.data.summary}><EntityProfile entry={entry} type="Campaign"/></BaseLayout>
