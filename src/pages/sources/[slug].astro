---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntityProfile from '../../components/EntityProfile.astro';
import { loadKnowledge } from '../../utils/knowledge';

export async function getStaticPaths() {
  const knowledge = await loadKnowledge();
  return knowledge.sources.map((entry: any) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const knowledge = await loadKnowledge();
const d = entry.data;
---
<BaseLayout title={d.title} description={`Source record for ${d.title}, published by ${d.publisher}.`} type="ProfilePage" image={`/og/generated/source-${d.slug}.png`} imageAlt={`${d.title} source record by APT Notes`}>
  <EntityProfile entry={entry} collection="sources" knowledge={knowledge} />
</BaseLayout>
