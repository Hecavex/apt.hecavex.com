---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogueMoved from '../../components/knowledge/CatalogueMoved.astro';
import { publicEntries } from '../../utils/content';
const entries = await publicEntries('sources');
---
<BaseLayout title="References moved to Knowledge" description="Public reference records now appear in the Knowledge explorer." noindex={true}>
  <CatalogueMoved name="References" href="/knowledge/?view=references" count={entries.length} description="Reference records now expose publication metadata, preservation state and every public record that cites them." />
</BaseLayout>
