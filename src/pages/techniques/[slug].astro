---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntityProfile from '../../components/EntityProfile.astro';
import { loadKnowledge } from '../../utils/knowledge';

export async function getStaticPaths() {
  const knowledge = await loadKnowledge();
  return knowledge.techniques.map((entry: any) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const knowledge = await loadKnowledge();
const d = entry.data;
---
<BaseLayout title={`${d.mitre_id} ${d.name}`} description={d.summary} type="ProfilePage" image={`/og/generated/technique-${d.slug}.png`} imageAlt={`${d.mitre_id} ${d.name} technique record by APT Notes`}>
  <EntityProfile entry={entry} collection="techniques" knowledge={knowledge} />
</BaseLayout>
