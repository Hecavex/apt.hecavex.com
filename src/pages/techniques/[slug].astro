---
import {getCollection,render} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import {publicEntries,bySlug,formatDate} from '../../utils/content';export async function getStaticPaths(){return (await getCollection('techniques',({data})=>!data.draft)).map(entry=>({params:{slug:entry.data.slug},props:{entry}}))}const{entry}=Astro.props;const{Content}=await render(entry);const sourceMap=bySlug(await publicEntries('sources') as any);const d=entry.data;
---
<BaseLayout title={`${d.mitre_id} ${d.name}`} description={d.summary}><article class="shell narrow prose" data-pagefind-body data-pagefind-meta="type:Technique"><p class="eyebrow">Technique · <span class="mono">{d.mitre_id}</span></p><h1>{d.name}</h1><p class="lead">{d.summary}</p><dl class="fact-grid"><div class="fact"><dt>MITRE ID</dt><dd>{d.mitre_id}</dd></div><div class="fact"><dt>Tactic</dt><dd>{d.tactic}</dd></div></dl><Content/><h2>Sources</h2><ol>{d.sources.map((id:string)=>{const s:any=sourceMap.get(id);return <li>{s?<a href={s.data.url}>{s.data.title} — {s.data.publisher}, {formatDate(s.data.published_at)}</a>:id}</li>})}</ol></article></BaseLayout>
