---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogueMoved from '../../components/knowledge/CatalogueMoved.astro';
import { publicEntries } from '../../utils/content';
const entries = await publicEntries('techniques');
---
<BaseLayout title="Techniques moved to Knowledge" description="ATT&amp;CK technique mappings now appear in the Knowledge explorer." noindex={true}>
  <CatalogueMoved name="Techniques" href="/knowledge/?view=techniques" count={entries.length} description="Technique records now foreground sourced procedure evidence and clearly label broader catalogue mappings." />
</BaseLayout>
