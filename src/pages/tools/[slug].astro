---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntityProfile from '../../components/EntityProfile.astro';
import { loadKnowledge } from '../../utils/knowledge';

export async function getStaticPaths() {
  const knowledge = await loadKnowledge();
  return knowledge.tools.map((entry: any) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const knowledge = await loadKnowledge();
---
<BaseLayout title={`${entry.data.name} | Tool`} description={entry.data.summary} type="ProfilePage" image={`/og/generated/tool-${entry.data.slug}.png`} imageAlt={`${entry.data.name} tool record by APT Notes`}>
  <EntityProfile entry={entry} collection="tools" knowledge={knowledge} />
</BaseLayout>
