---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogueMoved from '../../components/knowledge/CatalogueMoved.astro';
import { publicEntries } from '../../utils/content';
const entries = await publicEntries('tools');
---
<BaseLayout title="Tools moved to Knowledge" description="Tool records now appear in the combined Software view." noindex={true}>
  <CatalogueMoved name="Tools" href="/knowledge/?view=software&kind=tool" count={entries.length} description="Malware and tools now share one Software view while retaining distinct record types." />
</BaseLayout>
