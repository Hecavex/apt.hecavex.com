---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Search" description="Search public APT Notes actors, supporting records and references." noindex={true}>
  <section class="shell narrow search-page">
    <header class="page-head"><div><p class="eyebrow">Local static search</p><h1>Search APT Notes</h1><p class="lead">Search actor names and aliases, campaigns, software, ATT&amp;CK IDs, reference titles and publishers. Drafts are excluded.</p></div></header>
    <form class="search-hero" id="search-form"><label class="sr-only" for="search-q">Search</label><input id="search-q" name="q" type="search" placeholder="Name, alias, MITRE ID or publisher" autofocus/><button>Search</button></form>
    <p class="meta" id="search-status" role="status">Enter a search term.</p>
    <div id="search-results" class="database-list"></div>
    <button id="search-more" type="button" hidden>Load more results</button>
    <div class="empty" id="search-empty" hidden><h2>No results</h2><p>Try an alias, MITRE ID, campaign, technique or publisher.</p></div>
    <p>Browse <a href="/actors/">actors</a>, <a href="/knowledge/">supporting records</a> or <a href="/relationships/">relationships</a>.</p>
    <noscript><p>Search requires JavaScript. Use the catalogue links above to browse the public records.</p></noscript>
  </section>
  <script is:inline type="module" src="/scripts/search.js"></script>
</BaseLayout>
