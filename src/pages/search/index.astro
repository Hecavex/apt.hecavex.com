---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Search" description="Search public APT Notes entities and sources." noindex={true}><section class="shell narrow"><header class="page-head"><div><p class="eyebrow">Local static search</p><h1>Search APT Notes</h1><p class="lead">Results include public actors, campaigns, malware, tools, techniques and sources. Drafts are excluded.</p></div></header><form class="search-hero" id="search-form"><label class="sr-only" for="search-q">Search</label><input id="search-q" name="q" type="search" placeholder="Search actors, aliases, campaigns, malware or techniques" autofocus/><button>Search</button></form><p class="meta" id="search-status" aria-live="polite">Enter a search term.</p><div id="search-results" class="database-list"></div></section><script>
const form=document.querySelector<HTMLFormElement>('#search-form')!;const input=document.querySelector<HTMLInputElement>('#search-q')!;const output=document.querySelector('#search-results')!;const status=document.querySelector('#search-status')!;let engine:any;
const escape=(v:string)=>v.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
const run=async()=>{const q=input.value.trim().slice(0,160);const params=new URLSearchParams();if(q)params.set('q',q);history.replaceState(null,'',`${location.pathname}${params.size?'?'+params:''}`);output.innerHTML='';if(!q){status.textContent='Enter a search term.';return}status.textContent='Searching…';try{
// @ts-expect-error Pagefind creates this browser module after Astro builds the site.
engine??=await import(/* @vite-ignore */ '/pagefind/pagefind.js');await engine.init();const search=await engine.search(q);const data=await Promise.all(search.results.slice(0,30).map((r:any)=>r.data()));status.textContent=`${search.results.length} ${search.results.length===1?'result':'results'}`;if(!data.length){output.innerHTML='<div class="empty"><h2>No results</h2><p>Try an alias, MITRE ID, sector, region or publisher.</p></div>';return}output.innerHTML=data.map((r:any)=>`<article class="db-row"><div class="db-cell"><h2><a href="${encodeURI(r.url)}">${escape(r.meta.title||'Untitled')}</a></h2><p>${r.excerpt}</p></div><div class="db-cell"><small>Type</small>${escape(r.meta.type||'Record')}</div></article>`).join('')}catch{status.textContent='Search is available in the production build and preview.'}};
const q=new URLSearchParams(location.search).get('q');if(q){input.value=q;run()}form.addEventListener('submit',e=>{e.preventDefault();run()});
</script></BaseLayout>
