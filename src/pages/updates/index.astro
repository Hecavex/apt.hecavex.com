---
import BaseLayout from '../../layouts/BaseLayout.astro';import{publicEntries,formatDate,label}from'../../utils/content';const updates:any[]=(await publicEntries('updates')).sort((a:any,b:any)=>+new Date(b.data.date)-+new Date(a.data.date));
---
<BaseLayout title="Updates" description="Chronological record of substantive intelligence and editorial changes."><section class="shell narrow"><header class="page-head"><div><p class="eyebrow">Change log</p><h1>Updates</h1><p class="lead">A chronological record of profile creation, attribution changes, corrections and other substantive intelligence changes.</p></div></header><ol class="timeline" data-pagefind-body>{updates.map(u=><li data-pagefind-meta="type:Update"><time datetime={u.data.date.toISOString()}>{formatDate(u.data.date)}</time><span class="badge">{label(u.data.update_type)}</span><h2>{u.data.title}</h2><p>{u.data.summary}</p><p class="meta">Entity: <a href={`/${u.data.entity_type}s/${u.data.entity}/`}>{u.data.entity}</a></p></li>)}</ol></section></BaseLayout>
