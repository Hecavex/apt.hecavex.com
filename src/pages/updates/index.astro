---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Updates moved to Changes" description="The APT Notes public revision record is now published under Changes." noindex={true}>
  <section class="shell narrow prose compatibility-page">
    <p class="eyebrow">Compatibility route</p>
    <h1>Updates are now Changes</h1>
    <p class="lead">The revision record now distinguishes what changed, why it changed, affected fields, record versions and stable machine-readable events.</p>
    <p><a class="button" href="/changes/">Open Changes →</a></p>
  </section>
</BaseLayout>
<script is:inline>
  if (location.hash) location.replace(`/changes/${location.hash}`);
</script>
