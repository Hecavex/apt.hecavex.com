---
import AppHeader from '../components/AppHeader.astro';
import '../styles/global.css';

interface Props { title?: string; description?: string; type?: string; noindex?: boolean; image?: string; imageAlt?: string; }
const { title = 'APT Notes by HECAVEX', description = 'A structured knowledge base of threat actors and their operations.', type = 'CollectionPage', noindex = false, image = '/og/default.png', imageAlt = `${title} social preview` } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === 'APT Notes by HECAVEX' ? title : `${title} | APT Notes by HECAVEX`;
const pageId = `${canonical.href}#webpage`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': 'https://hecavex.com/#organization', name: 'HECAVEX', url: 'https://hecavex.com/', founder: { '@id': 'https://hecavex.com/#deividas-lis' }, sameAs: ['https://github.com/Hecavex', 'https://www.linkedin.com/in/deilis'] },
    { '@type': 'Person', '@id': 'https://hecavex.com/#deividas-lis', name: 'Deividas Lis', url: 'https://hecavex.com/en/about/' },
    { '@type': 'WebSite', '@id': 'https://hecavex.com/#website', name: 'HECAVEX', url: 'https://hecavex.com/', hasPart: [{ '@id': 'https://apt.hecavex.com/#website' }, { '@id': 'https://labs.hecavex.com/#website' }, { '@id': 'https://radar.hecavex.com/#website' }] },
    { '@type': 'WebSite', '@id': 'https://apt.hecavex.com/#website', name: 'APT Notes by HECAVEX', url: 'https://apt.hecavex.com/', description: 'A source-driven knowledge base of threat actors, campaigns, malware, tools and techniques.', isPartOf: { '@id': 'https://hecavex.com/#website' }, creator: { '@id': 'https://hecavex.com/#deividas-lis' }, publisher: { '@id': 'https://hecavex.com/#organization' } },
    { '@type': 'WebSite', '@id': 'https://labs.hecavex.com/#website', name: 'HECAVEX Labs', url: 'https://labs.hecavex.com/', isPartOf: { '@id': 'https://hecavex.com/#website' } },
    { '@type': 'WebSite', '@id': 'https://radar.hecavex.com/#website', name: 'HECAVEX Radar', url: 'https://radar.hecavex.com/', description: 'A public dashboard of potential phishing infrastructure relevant to Lithuania.', isPartOf: { '@id': 'https://hecavex.com/#website' } },
    { '@type': type, '@id': pageId, name: title, description, url: canonical.href, inLanguage: 'en', isPartOf: { '@id': 'https://apt.hecavex.com/#website' }, author: { '@id': 'https://hecavex.com/#deividas-lis' }, publisher: { '@id': 'https://hecavex.com/#organization' }, primaryImageOfPage: { '@type': 'ImageObject', url: new URL(image, Astro.site).href, width: 1200, height: 630 } }
  ]
};
const measurementToken = import.meta.env.PUBLIC_HECAVEX_ANALYTICS_TOKEN?.trim() ?? '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicons/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/lib/fontawesome-free/css/all.min.css" />
    <link rel="alternate" type="application/atom+xml" title="APT Notes updates" href="/feed.xml" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content="website" /><meta property="og:site_name" content="APT Notes by HECAVEX" /><meta property="og:locale" content="en_US" /><meta property="og:title" content={fullTitle} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={new URL(image, Astro.site)} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={fullTitle} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={new URL(image, Astro.site)} /><meta name="twitter:image:alt" content={imageAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      (() => { try { const mode = localStorage.getItem('apt-notes-theme'); if (mode === 'dark' || mode === 'light') document.documentElement.dataset.theme = mode; } catch {} })();
    </script>
    {measurementToken && <script is:inline define:vars={{ measurementToken }}>
      (() => {
        if (navigator.doNotTrack === '1' || window.doNotTrack === '1') return;
        const beacon = document.createElement('script');
        beacon.defer = true;
        beacon.src = 'https://static.cloudflareinsights.com/beacon.min.js';
        beacon.dataset.cfBeacon = JSON.stringify({ token: measurementToken });
        document.head.appendChild(beacon);
      })();
    </script>}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <AppHeader />
    <main id="main-content"><slot /></main>
    <footer><span>Part of <a href="https://hecavex.com/en/">HECAVEX</a></span><nav aria-label="Footer"><a href="https://hecavex.com/en/">Research</a><a href="https://labs.hecavex.com/">Labs</a><a href="https://radar.hecavex.com/">Radar</a><a href="/about/methodology/">Methodology</a><a href="/feed.xml">Feed</a><a href="https://hecavex.com/en/privacy/">Privacy</a><a href="/security/">Security</a></nav></footer>
  </body>
</html>
