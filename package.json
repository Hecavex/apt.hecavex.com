{
  "name": "apt-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate && npm run build:og && astro check && astro build && pagefind --site dist",
    "build:og": "node scripts/generate-og.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "audit": "node scripts/audit-build.mjs && npm run audit:data && npm run audit:performance",
    "audit:data": "node scripts/audit-data.mjs",
    "audit:performance": "node scripts/audit-performance.mjs",
    "check:sources": "node scripts/check-source-links.mjs",
    "lint": "node scripts/lint.mjs",
    "test:content": "node scripts/test-content-validation.mjs",
    "validate": "node scripts/validate-content.mjs",
    "verify": "npm run lint && npm run test:content && npm run build && npm run audit"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "fontkit": "2.0.4",
    "pagefind": "1.5.2",
    "sharp": "^0.35.3",
    "typescript": "latest",
    "yaml": "latest"
  }
}
