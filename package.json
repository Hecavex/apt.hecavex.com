{
  "name": "apt-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate && astro check && astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "node scripts/lint.mjs",
    "validate": "node scripts/validate-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "pagefind": "1.5.2",
    "typescript": "latest",
    "yaml": "latest"
  }
}
